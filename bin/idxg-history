#!/bin/sh
# idxg history <subcommand>, resolving symlinks so an installed link still finds src/
SELF=$0
while [ -L "$SELF" ]; do
    LINK=$(readlink "$SELF")
    case $LINK in
        /*) SELF=$LINK ;;
        *) SELF=$(dirname "$SELF")/$LINK ;;
    esac
done
DIR=$(cd "$(dirname "$SELF")" && pwd)
exec python3 "$DIR/../src/idxg.py" history "$@"
